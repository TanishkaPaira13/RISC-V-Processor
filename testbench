
module testbench;
    reg clk;
    reg reset;
    wire [31:0] writedata, dataadr;
    wire memwrite;

    top dut(clk, reset, writedata, dataadr, memwrite);

    initial begin
        reset = 1'b1;
        #22;
        reset = 1'b0;
    end

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    always @(negedge clk) begin
        if (memwrite) begin
            if ((dataadr === 32'd84) && (writedata === 32'd71)) begin
                $display("Simulation succeeded");
                $finish;
            end else if (dataadr !== 32'd80) begin
                $display("Simulation failed: address=%0d data=%0d", dataadr, writedata);
                $finish;
            end
        end
    end

    initial begin
        #2000;
        $display("Simulation timed out: expected store was not observed");
        $finish;
    end
endmodule
